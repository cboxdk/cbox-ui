{
    "name": "@cboxdk/cbox-ui",
    "version": "0.1.0",
    "private": false,
    "description": "Cbox shared UI — layout primitives, design tokens, and brand assets used across every Cbox-family app (id, cortex, atlas, track, …).",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cboxdk/cbox-ui.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "type": "module",
    "license": "UNLICENSED",
    "files": [
        "dist",
        "tokens",
        "assets",
        "tailwind.preset.js",
        "README.md",
        "BRAND.md"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tokens": "./tokens/cbox.css",
        "./tailwind": "./tailwind.preset.js",
        "./assets/*": "./assets/*"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "lucide-react": ">=0.400.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "lucide-react": {
            "optional": true
        }
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "lucide-react": "^0.469.0",
        "tsup": "^8.3.0",
        "typescript": "^5.6.0"
    }
}
