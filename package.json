{
    "name": "@cboxdk/cbox-ui",
    "version": "0.10.4",
    "private": false,
    "description": "Cbox shared UI — layout primitives, design tokens, and brand assets used across every Cbox-family app (id, cortex, atlas, track, …).",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cboxdk/cbox-ui.git"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "type": "module",
    "license": "MIT",
    "files": [
        "LICENSE",
        "TRADEMARKS.md",
        "dist",
        "tokens",
        "assets",
        "tailwind.preset.js",
        "README.md",
        "BRAND.md"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./charts": {
            "types": "./dist/charts.d.ts",
            "import": "./dist/charts.js"
        },
        "./app-switcher": {
            "types": "./dist/app-switcher.d.ts",
            "import": "./dist/app-switcher.js"
        },
        "./tokens": "./tokens/cbox.css",
        "./tailwind": "./tailwind.preset.js",
        "./assets/*": "./assets/*",
        "./shell.css": "./tokens/shell.css"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "test:visual": "scripts/visual.sh",
        "test:visual:update": "scripts/visual.sh --update-snapshots"
    },
    "peerDependencies": {
        "echarts": "^6.0.0",
        "lucide-react": ">=0.400.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "lucide-react": {
            "optional": true
        },
        "echarts": {
            "optional": true
        }
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.11.0",
        "@playwright/test": "^1.65.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.9",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "echarts": "6.1.0",
        "happy-dom": "^20.14.6",
        "lucide-react": "^0.469.0",
        "tsup": "^8.3.0",
        "typescript": "^5.6.0",
        "vitest": "^4.1.5"
    }
}
